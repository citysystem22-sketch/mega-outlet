<Window x:Class="MegaOutletCheck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MegaOutletCheck.ViewModels"
        mc:Ignorable="d"
        Title="Mega Outlet - Sprawdź dostępność"
        MinWidth="800" MinHeight="600"
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource DefaultFontFamily}"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Search Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Color="Black" Direction="270"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Logo -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" MinWidth="100">
                    <TextBlock Text="MEGA OUTLET" FontSize="18" FontWeight="Bold" Foreground="#1E40AF"/>
                    <TextBlock Text="sprawdź dostępność" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,-1,0,0"/>
                </StackPanel>

                <!-- Search Box -->
                <Grid Grid.Column="1" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBox x:Name="SearchBox"
                             Grid.Row="0"
                             Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             GotFocus="SearchBox_GotFocus"
                             KeyDown="SearchBox_KeyDown"/>
                    
                    <!-- Placeholder text -->
                    <TextBlock Grid.Row="0"
                               Text="🔍 Szukaj produkty, SKU, lub słowa kluczowe..."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="18"
                               Margin="44,14,16,14"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Invert}"/>
                    
                    <!-- Clear button -->
                    <Button Grid.Row="0"
                            Content="✕"
                            Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right"
                            Margin="0,0,8,0"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}}"
                            ToolTip="Wyczyść"/>
                    
                    <!-- Loading bar under search (browser-style) -->
                    <ProgressBar Grid.Row="1"
                                IsIndeterminate="True"
                                Height="3"
                                Margin="0,2,0,0"
                                Background="Transparent"
                                Foreground="#3B82F6"
                                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
                
                <!-- Filter: Only Available -->
                <CheckBox Grid.Column="2"
                          Content="✓ Tylko dostępne"
                          IsChecked="{Binding ShowOnlyAvailable}"
                          VerticalAlignment="Center"
                          FontSize="13"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,16,0"/>

                <!-- Offline indicator -->
                <Border Grid.Column="3"
                         Background="{StaticResource LowStockBrush}"
                         CornerRadius="8"
                         Padding="12,8"
                         Margin="0,0,16,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsOfflineMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="⚠️ Tryb offline"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- Settings button -->
                <Button Grid.Column="4"
                        Content="⚙️"
                        Style="{StaticResource IconButton}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="Ustawienia"/>
            </Grid>
        </Border>

        <!-- Floating Keyboard Button (FAB) -->
        <Button x:Name="KeyboardToggle"
                Grid.Row="2"
                Content="⌨️"
                Click="KeyboardToggle_Click"
                ToolTip="Klawiatura ekranowa"
                Width="56" Height="56"
                FontSize="24"
                Background="#3B82F6"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,70,24,0">
            <Button.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.3" Color="#000000"/>
            </Button.Effect>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="28"
                                        Padding="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2563EB"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Error message -->
            <Border Grid.Row="0"
                    Background="#FFEBEE"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️ "
                               FontSize="16"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Product Results Grid -->
            <ScrollViewer Grid.Row="0"
                          x:Name="ResultsScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProductCard}"
                                    Width="320"
                                    Height="340"
                                    Margin="10"
                                    MouseLeftButtonUp="ProductCard_Click"
                                    Tag="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Product Image with Gallery -->
                                    <Grid Grid.Row="0">
                                        <Image Source="{Binding PrimaryImageUrl, Converter={StaticResource ImageUrlToSourceConverter}}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        
                                        <!-- Image Count Badge -->
                                        <Border Background="#000000AA"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="8"
                                                Visibility="{Binding Images.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                            <TextBlock Foreground="White" FontSize="11">
                                                <Run Text="{Binding Images.Count, Mode=OneWay}"/>
                                                <Run Text=" zdj."/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Product Name -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Name}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               MaxHeight="44"
                                               Margin="0,12,0,12"/>

                                    <!-- Price and Stock -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayPrice}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                            
                                            <TextBlock Text=" zł"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="2,0,0,3"/>
                                        </StackPanel>

                                        <Border Grid.Column="4"
                                                Background="{Binding Converter={StaticResource StockStatusToBrushConverter}}"
                                                CornerRadius="4"
                                                Padding="10,4"
                                                MinWidth="36">
                                            <TextBlock Text="{Binding StockQuantityDisplay}"
                                                      Foreground="White"
                                                      FontSize="12"
                                                      FontWeight="Bold"
                                                      HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- On-Screen Keyboard Panel (bottom row) -->
            <Border Grid.Row="1"
                    x:Name="KeyboardPanel"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="16"
                    Margin="24,8,24,8"
                    MaxWidth="900"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="⌨️ Klawiatura ekranowa"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                Click="KeyboardToggle_Click"
                                Style="{StaticResource IconButton}"/>
                    </Grid>
                    
                    <!-- Row 1: QWERTYUIOP -->
                    <UniformGrid Rows="1" Margin="0,0,0,4">
                        <Button Content="Q" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="W" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="E" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="R" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="T" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="Y" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="U" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="I" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="O" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="P" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                    </UniformGrid>
                    
                    <!-- Row 2: ASDFGHJKL -->
                    <UniformGrid Rows="1" Margin="0,0,0,4">
                        <Button Content="A" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="S" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="D" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="F" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="G" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="H" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="J" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="K" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="L" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                    </UniformGrid>
                    
                    <!-- Row 3: ZXCVBNM -->
                    <UniformGrid Rows="1" Margin="0,0,0,4">
                        <Button Content="Z" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="X" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="C" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="V" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="B" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="N" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="M" Click="KeyButton_Click" Style="{StaticResource KeyboardKey}"/>
                        <Button Content="⌫" Click="BackspaceButton_Click" Style="{StaticResource KeyboardKey}"/>
                    </UniformGrid>
                    
                    <!-- Row 4: Space and Enter -->
                    <UniformGrid Rows="1">
                        <Button Content="Space" Click="KeyButton_Click" Style="{StaticResource KeyboardKeySpace}"/>
                        <Button Content="Szukaj 🔎" Click="SearchButton_Click" Style="{StaticResource PrimaryButton}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Details Panel (slides in from right) -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                HorizontalAlignment="Right"
                Width="500"
                Background="{StaticResource SurfaceBrush}"
                Visibility="{Binding IsDetailsPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="-4" Opacity="0.15" Color="Black"/>
            </Border.Effect>
            
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Close button header -->
                <Grid Grid.Row="0" Margin="16,16,16,0">
                    <TextBlock Text="{Binding SelectedProduct.Name}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               MaxHeight="60"/>
                    
                    <Button Content="✕"
                            Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseDetailsPanelCommand}"/>
                </Grid>

                <!-- Product details -->
                <ScrollViewer Grid.Row="1" Margin="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Product Image Gallery - With Navigation -->
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="12"
                                Margin="0,16,0,16"
                                MinHeight="320">
                            <Grid>
                                <!-- Main Image -->
                                <Image Source="{Binding SelectedProduct.CurrentImageUrl, Converter={StaticResource ImageUrlToSourceConverter}}"
                                       MaxHeight="380"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"/>
                                
                                <!-- Placeholder when no image -->
                                <TextBlock Text="📷 Brak zdjęcia"
                                           FontSize="48"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SelectedProduct.PrimaryImageUrl, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Invert}"/>
                                
                                <!-- Previous Arrow (left) -->
                                <Button Content="◀"
                                        Command="{Binding PreviousProductImageCommand}"
                                        Style="{StaticResource IconButton}"
                                        FontSize="24"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Width="50"
                                        Background="#80000000"
                                        Foreground="White"
                                        Visibility="{Binding SelectedProduct.Images.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                                
                                <!-- Next Arrow (right) -->
                                <Button Content="▶"
                                        Command="{Binding NextProductImageCommand}"
                                        Style="{StaticResource IconButton}"
                                        FontSize="24"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        Width="50"
                                        Background="#80000000"
                                        Foreground="White"
                                        Visibility="{Binding SelectedProduct.Images.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                                
                                <!-- Image count indicator -->
                                <Border Background="#000000AA"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="12"
                                        Visibility="{Binding SelectedProduct.Images.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                    <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold">
                                        <Run Text="{Binding SelectedProduct.CurrentImageIndex, Mode=OneWay}"/>
                                        <Run Text="/"/>
                                        <Run Text="{Binding SelectedProduct.Images.Count, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Price Section -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding SelectedProduct.DisplayPrice}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedProduct.DisplayOriginalPrice}"
                                       FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextDecorations="Strikethrough"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SelectedProduct.DisplayOriginalPrice, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Stock status - simple quantity only -->
                        <Border Background="{Binding SelectedProduct, Converter={StaticResource StockStatusToBrushConverter}}"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedProduct.StockDisplayText}"
                                      Foreground="White"
                                      FontSize="14"
                                      FontWeight="SemiBold"/>
                        </Border>

                        <!-- Description Section - Full Width -->
                        <TextBlock Text="Opis produktu"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,16,0,12"/>
                        
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,16">
                            <TextBlock Text="{Binding SelectedProduct.DisplayDescription}"
                                           FontSize="15"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="26"/>
                        </Border>

                        <!-- Categories - Hidden -->
                        <ItemsControl ItemsSource="{Binding SelectedProduct.Categories}" Margin="0,16,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#E2E8F0"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="0,0,8,8">
                                        <TextBlock Text="{Binding Name}"
                                                  FontSize="12"
                                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Settings Dialog -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#80000000"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                MouseLeftButtonUp="SettingsOverlay_Click">
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16"
                    Width="400"
                    MaxHeight="600"
                    Padding="24"
                    VerticalAlignment="Center"
                    MouseLeftButtonUp="SettingsDialog_Click">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,24">
                            <TextBlock Text="Ustawienia"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            
                            <Button Content="✕"
                                    Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CloseSettingsCommand}"/>
                        </Grid>

                        <!-- Store URL -->
                        <TextBlock Text="URL sklepu"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SettingsStoreUrl, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Padding="12"
                                 Margin="0,0,0,16"/>

                        <!-- API Key -->
                        <TextBlock Text="Klucz API (Consumer Key)"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SettingsApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Padding="12"
                                 Margin="0,0,0,16"/>

                        <!-- API Secret -->
                        <TextBlock Text="Sekret API (Consumer Secret)"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <PasswordBox x:Name="ApiSecretBox"
                                   FontSize="14"
                                   Padding="12"
                                   Margin="0,0,0,16"
                                   PasswordChanged="ApiSecretBox_PasswordChanged"/>

                        <!-- Test Connection Button -->
                        <Button Content="Testuj połączenie"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,8"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InvertBoolConverter}}"/>

                        <!-- Connection Status -->
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontSize="14"
                                   Margin="0,0,0,16"
                                   TextWrapping="Wrap"/>

                        <!-- Save Button -->
                        <Button Content="Zapisz ustawienia"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveSettingsCommand}"/>

                        <!-- Theme Toggle -->
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tryb ciemny"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Włącz ciemny motyw dla wygodniejszego używania"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="4"
                                     IsChecked="{Binding IsDarkMode}"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Remember Credentials -->
                        <CheckBox Content="Zapamiętaj dane logowania"
                                  IsChecked="{Binding Settings.RememberCredentials}"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>