<Window x:Class="MegaOutletCheck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MegaOutletCheck.ViewModels"
        mc:Ignorable="d"
        Title="Mega Outlet - Sprawdź dostępność"
        MinWidth="800" MinHeight="600"
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource DefaultFontFamily}"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header / Search Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Color="Black" Direction="270"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             GotFocus="SearchBox_GotFocus"
                             KeyDown="SearchBox_KeyDown"/>
                    
                    <!-- Placeholder text -->
                    <TextBlock Text="🔍 Szukaj produkty, SKU, lub słowa kluczowe..."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="18"
                               Margin="44,14,16,14"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Invert}"/>
                    
                    <!-- Clear button -->
                    <Button Content="✕"
                            Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right"
                            Margin="0,0,8,0"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}}"
                            ToolTip="Wyczyść"/>
                </Grid>

                <!-- Offline indicator -->
                <Border Grid.Column="1"
                         Background="{StaticResource LowStockBrush}"
                         CornerRadius="8"
                         Padding="12,8"
                         Margin="0,0,16,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsOfflineMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="⚠️ Tryb offline"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- Settings button -->
                <Button Grid.Column="2"
                        Content="⚙️"
                        Style="{StaticResource IconButton}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="Ustawienia"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="24,16">
            <!-- Loading indicator -->
            <StackPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Szukam produkty..."
                           FontSize="20"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             Margin="0,16,0,0"/>
            </StackPanel>

            <!-- Error message -->
            <Border Background="#FFEBEE"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️ "
                               FontSize="16"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Product Results Grid -->
            <ScrollViewer x:Name="ResultsScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProductCard}"
                                    Width="240"
                                    Height="280"
                                    Margin="8"
                                    MouseLeftButtonUp="ProductCard_Click"
                                    Tag="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="120"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Product Image -->
                                    <Border Grid.Row="0"
                                            Background="#F1F5F9"
                                            CornerRadius="8">
                                        <Image Source="{Binding PrimaryImageUrl, Converter={StaticResource ImageUrlToSourceConverter}}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Product Name -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               MaxHeight="40"
                                               Margin="0,12,0,8"/>

                                    <!-- Price and Stock -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayPrice}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"/>

                                        <Border Grid.Column="1"
                                                Background="{Binding Converter={StaticResource StockStatusToBrushConverter}}"
                                                CornerRadius="4"
                                                Padding="8,4">
                                            <TextBlock Text="{Binding StockDisplayText}"
                                                      Foreground="White"
                                                      FontSize="11"
                                                      FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- No results message -->
            <StackPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding Products.Count, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Invert}">
                <TextBlock Text="📦"
                           FontSize="48"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Nie znaleziono produktów"
                           FontSize="20"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,16,0,0"/>
                <TextBlock Text="Spróbuj wpisać inną frazę"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Details Panel (slides in from right) -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                HorizontalAlignment="Right"
                Width="400"
                Background="{StaticResource SurfaceBrush}"
                Visibility="{Binding IsDetailsPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="-4" Opacity="0.15" Color="Black"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Close button header -->
                <Grid Grid.Row="0" Margin="16,16,16,0">
                    <TextBlock Text="{Binding SelectedProduct.Name}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               MaxHeight="60"/>
                    
                    <Button Content="✕"
                            Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseDetailsPanelCommand}"/>
                </Grid>

                <!-- Product details -->
                <ScrollViewer Grid.Row="1" Margin="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Image with placeholder -->
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="12"
                                Margin="0,16,0,16">
                            <Grid>
                                <Image Source="{Binding SelectedProduct.PrimaryImageUrl, Converter={StaticResource ImageUrlToSourceConverter}}"
                                       MaxHeight="350"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <!-- Placeholder when no image -->
                                <TextBlock Text="📷 Brak zdjęcia"
                                           FontSize="48"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SelectedProduct.PrimaryImageUrl, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Invert}"/>
                            </Grid>
                        </Border>

                        <!-- Price Section -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding SelectedProduct.DisplayPrice}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedProduct.DisplayOriginalPrice}"
                                       FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextDecorations="Strikethrough"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SelectedProduct.DisplayOriginalPrice, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Stock status with clear badge -->
                        <Border Background="{Binding SelectedProduct, Converter={StaticResource StockStatusToBrushConverter}}"
                                CornerRadius="8"
                                Padding="16,10"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedProduct.StockDisplayText}"
                                          Foreground="White"
                                          FontSize="15"
                                          FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Description Section -->
                        <TextBlock Text="Opis produktu"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,8,0,8"/>
                        
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,16">
                            <TextBlock Text="{Binding SelectedProduct.DisplayDescription}"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="22"/>
                        </Border>

                        <!-- Categories - Hidden per requirements -->
                        <ItemsControl ItemsSource="{Binding SelectedProduct.Categories}" 
                                    Margin="0,16,0,0"
                                    Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#E2E8F0"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="0,0,8,8">
                                        <TextBlock Text="{Binding Name}"
                                                  FontSize="12"
                                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Settings Dialog -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#80000000"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                MouseLeftButtonUp="SettingsOverlay_Click">
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16"
                    Width="400"
                    MaxHeight="600"
                    Padding="24"
                    VerticalAlignment="Center"
                    MouseLeftButtonUp="SettingsDialog_Click">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,24">
                            <TextBlock Text="Ustawienia"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            
                            <Button Content="✕"
                                    Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CloseSettingsCommand}"/>
                        </Grid>

                        <!-- Store URL -->
                        <TextBlock Text="URL sklepu"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SettingsStoreUrl, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Padding="12"
                                 Margin="0,0,0,16"/>

                        <!-- API Key -->
                        <TextBlock Text="Klucz API (Consumer Key)"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SettingsApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Padding="12"
                                 Margin="0,0,0,16"/>

                        <!-- API Secret -->
                        <TextBlock Text="Sekret API (Consumer Secret)"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <PasswordBox x:Name="ApiSecretBox"
                                   FontSize="14"
                                   Padding="12"
                                   Margin="0,0,0,16"
                                   PasswordChanged="ApiSecretBox_PasswordChanged"/>

                        <!-- Test Connection Button -->
                        <Button Content="Testuj połączenie"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,8"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InvertBoolConverter}}"/>

                        <!-- Connection Status -->
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontSize="14"
                                   Margin="0,0,0,16"
                                   TextWrapping="Wrap"/>

                        <!-- Save Button -->
                        <Button Content="Zapisz ustawienia"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveSettingsCommand}"/>

                        <!-- Theme Toggle -->
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tryb ciemny"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Włącz ciemny motyw dla wygodniejszego używania"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                     IsChecked="{Binding IsDarkMode}"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Remember Credentials -->
                        <CheckBox Content="Zapamiętaj dane logowania"
                                  IsChecked="{Binding Settings.RememberCredentials}"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>