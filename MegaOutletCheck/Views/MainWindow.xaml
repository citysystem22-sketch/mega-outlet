<Window x:Class="MegaOutletCheck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MegaOutletCheck.ViewModels"
        mc:Ignorable="d"
        Title="Mega Outlet - Sprawdź dostępność"
        MinWidth="800" MinHeight="600"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource DefaultFontFamily}"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Area -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="32,24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.1" Color="Black" Direction="270"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo / Box Icon - MAIN ELEMENT -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="12" Padding="12" Margin="0,0,16,0">
                        <TextBlock Text="📦" FontSize="32" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MEGA OUTLET" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Sprawdź dostępność" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search Box - Touch Friendly -->
                <Grid Grid.Column="1" Margin="48,0">
                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="16" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            
                            <TextBox Grid.Column="1"
                                     x:Name="SearchBox"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     GotFocus="SearchBox_GotFocus"
                                     KeyDown="SearchBox_KeyDown"
                                     FontSize="22"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     VerticalAlignment="Center"/>
                            
                            <Button Grid.Column="2"
                                    Content="✕"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Settings & Dark Mode -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Dark Mode Toggle -->
                    <ToggleButton IsChecked="{Binding IsDarkMode}"
                                Content="🌙"
                                Width="56"
                                Height="56"
                                FontSize="24"
                                ToolTip="Tryb ciemny"
                                Style="{StaticResource IconToggleButton}"
                                Margin="0,0,12,0"/>
                    
                    <!-- Settings Button -->
                    <Button Content="⚙️"
                            Style="{StaticResource IconButton}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Ustawienia"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,24">
            <StackPanel>
                <!-- Quick Category Buttons - Touch Optimized -->
                <Border Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Text="KATEGORIE" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                        <WrapPanel>
                            <Button Content="📱 Telefony" Style="{StaticResource CategoryButton}" Click="CategoryButton_Click" Tag="telefon" Margin="0,0,12,12"/>
                            <Button Content="💻 Laptopy" Style="{StaticResource CategoryButton}" Click="CategoryButton_Click" Tag="laptop" Margin="0,0,12,12"/>
                            <Button Content="🎧 Audio" Style="{StaticResource CategoryButton}" Click="CategoryButton_Click" Tag="audio" Margin="0,0,12,12"/>
                            <Button Content="⌚ Zegarki" Style="{StaticResource CategoryButton}" Click="CategoryButton_Click" Tag="zegarek" Margin="0,0,12,12"/>
                            <Button Content="📺 TV" Style="{StaticResource CategoryButton}" Click="CategoryButton_Click" Tag="tv" Margin="0,0,12,12"/>
                            <Button Content="🎮 Gaming" Style="{StaticResource CategoryButton}" Click="CategoryButton_Click" Tag="gaming" Margin="0,0,12,12"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- New Products Carousel Section -->
                <Border Margin="0,0,0,32">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="🆕 NOWE PRODUKTY" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button Content="Zobacz wszystkie →"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource TextButton}"
                                    Click="ViewAllButton_Click"/>
                        </Grid>
                        
                        <!-- Horizontal ScrollViewer for Carousel -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Products}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ProductCard}"
                                                Width="200"
                                                Height="280"
                                                Margin="0,0,16,0"
                                                MouseLeftButtonUp="ProductCard_Click"
                                                Tag="{Binding}"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="140"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Product Image -->
                                                <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="8">
                                                    <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                                
                                                <!-- Product Name -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap"
                                                           Margin="0,8"/>
                                                
                                                <!-- Price & Stock -->
                                                <StackPanel Grid.Row="2">
                                                    <TextBlock Text="{Binding DisplayPrice}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                    <Border Background="{Binding Converter={StaticResource StockStatusToBrushConverter}}"
                                                            CornerRadius="4"
                                                            Padding="8,4"
                                                            Margin="0,4,0,0"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding StockDisplayText}"
                                                                  Foreground="White"
                                                                  FontSize="11"
                                                                  FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Search Results Section -->
                <Border>
                    <StackPanel>
                        <TextBlock Text="WYNIKI WYSZUKIWANIA" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        
                        <!-- Loading -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,32"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Szukam produkty..." FontSize="20" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,16,0,0"/>
                        </StackPanel>
                        
                        <!-- Empty State -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,48"
                                  Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Invert}">
                            <TextBlock Text="🔍" FontSize="64" HorizontalAlignment="Center"/>
                            <TextBlock Text="Wpisz nazwę produktu" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="Lub wybierz kategorię powyżej" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                        
                        <!-- Product Grid -->
                        <ItemsControl ItemsSource="{Binding Products}"
                                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductCard}"
                                            Width="220"
                                            Height="280"
                                            Margin="8"
                                            MouseLeftButtonUp="ProductCard_Click"
                                            Tag="{Binding}"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                    
                                            <!-- Product Image -->
                                            <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="8">
                                                <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                    
                                            <!-- Product Name -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="40"
                                                       Margin="0,12,0,0"/>
                                    
                                            <!-- Price and Stock -->
                                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding DisplayPrice}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                                <Border Background="{Binding Converter={StaticResource StockStatusToBrushConverter}}"
                                                        CornerRadius="4"
                                                        Padding="8,4"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StockDisplayText}"
                                                              Foreground="White"
                                                              FontSize="11"
                                                              FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Settings Dialog -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#80000000"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                MouseLeftButtonUp="SettingsOverlay_Click">
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16"
                    Width="450"
                    MaxHeight="650"
                    Padding="32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MouseLeftButtonUp="SettingsDialog_Click">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,24">
                            <TextBlock Text="⚙️ Ustawienia"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button Content="✕"
                                    Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CloseSettingsCommand}"/>
                        </Grid>

                        <!-- Store URL -->
                        <TextBlock Text="URL sklepu" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SettingsStoreUrl, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="16" Margin="0,0,0,16"/>

                        <!-- API Key -->
                        <TextBlock Text="Klucz API (Consumer Key)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SettingsApiKey, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="16" Margin="0,0,0,16"/>

                        <!-- API Secret -->
                        <TextBlock Text="Sekret API (Consumer Secret)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="ApiSecretBox" FontSize="16" Padding="16" Margin="0,0,0,16" PasswordChanged="ApiSecretBox_PasswordChanged"/>

                        <!-- Test Connection -->
                        <Button Content="Testuj połączenie"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,8"
                                Command="{Binding TestConnectionCommand}"/>
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>

                        <!-- Save -->
                        <Button Content="Zapisz ustawienia"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,24"
                                Command="{Binding SaveSettingsCommand}"/>

                        <!-- Theme -->
                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🌙 Tryb ciemny" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Włącz ciemny motyw" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsDarkMode}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Remember -->
                        <CheckBox Content="Zapamiętaj dane logowania"
                                  IsChecked="{Binding Settings.RememberCredentials}"
                                  Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>
