<Window x:Class="MegaOutletCheck.Views.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klawiatura"
        Width="600" Height="300"
        MinWidth="400" MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#FFFFFF"
            CornerRadius="12"
            Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar with Drag -->
            <Grid Grid.Row="0" Margin="4,4,4,8" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <TextBlock Text="⌨️ Klawiatura ekranowa"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           VerticalAlignment="Center"/>
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#6B7280"
                        FontSize="14"
                        Cursor="Hand"
                        Padding="8,4"/>
            </Grid>

            <!-- Polish char popup (hidden by default) -->
            <Popup x:Name="PolishPopup"
                   Placement="Top"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False">
                <Border Background="White"
                       CornerRadius="8"
                       Padding="8"
                       BorderBrush="#E5E7EB"
                       BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" x:Name="PolishCharsPanel"/>
                </Border>
            </Popup>

            <!-- Keyboard Grid -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Row 1: QWERTYUIOP -->
                    <UniformGrid Rows="1" Margin="0,0,0,4">
                        <Button x:Name="BtnQ" Content="Q" Click="KeyButton_Click" PreviewMouseLeftButtonDown="Key_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Key_PreviewMouseLeftButtonUp" Style="{DynamicResource KeyboardKey}"/>
                        <Button x:Name="BtnW" Content="W" Click="KeyButton_Click" PreviewMouseLeftButtonDown="Key_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Key_PreviewMouseLeftButtonUp" Style="{DynamicResource KeyboardKey}"/>
                        <Button x:Name="BtnE" Content="E" Click="KeyButton_Click" PreviewMouseLeftButtonDown="Key_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Key_PreviewMouseLeftButtonUp" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="R" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="T" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="Y" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="U" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="I" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button x:Name="BtnO" Content="O" Click="KeyButton_Click" PreviewMouseLeftButtonDown="Key_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Key_PreviewMouseLeftButtonUp" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="P" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                    </UniformGrid>

                    <!-- Row 2: ASDFGHJKL -->
                    <UniformGrid Rows="1" Margin="0,0,0,4">
                        <Button x:Name="BtnA" Content="A" Click="KeyButton_Click" PreviewMouseLeftButtonDown="Key_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Key_PreviewMouseLeftButtonUp" Style="{DynamicResource KeyboardKey}"/>
                        <Button x:Name="BtnS" Content="S" Click="KeyButton_Click" PreviewMouseLeftButtonDown="Key_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Key_PreviewMouseLeftButtonUp" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="D" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="F" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="G" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="H" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="J" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="K" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button x:Name="BtnL" Content="L" Click="KeyButton_Click" PreviewMouseLeftButtonDown="Key_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Key_PreviewMouseLeftButtonUp" Style="{DynamicResource KeyboardKey}"/>
                    </UniformGrid>

                    <!-- Row 3: ZXCVBNM -->
                    <UniformGrid Rows="1" Margin="0,0,0,4">
                        <Button x:Name="BtnZ" Content="Z" Click="KeyButton_Click" PreviewMouseLeftButtonDown="Key_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Key_PreviewMouseLeftButtonUp" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="X" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button x:Name="BtnC" Content="C" Click="KeyButton_Click" PreviewMouseLeftButtonDown="Key_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Key_PreviewMouseLeftButtonUp" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="V" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="B" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button x:Name="BtnN" Content="N" Click="KeyButton_Click" PreviewMouseLeftButtonDown="Key_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Key_PreviewMouseLeftButtonUp" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="M" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        <Button Content="⌫" Click="BackspaceButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="16"/>
                    </UniformGrid>

                    <!-- Row 4: Space, PL toggle, Search -->
                    <UniformGrid Rows="1">
                        <Button Content="Space" Click="KeyButton_Click" Style="{DynamicResource KeyboardKeySpace}"/>
                        <Button x:Name="BtnPL" Content="PL" Click="PolishToggle_Click" Style="{DynamicResource BaseButton}"/>
                        <Button Content="Szukaj 🔎" Click="SearchButton_Click" Style="{DynamicResource PrimaryButton}"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Polish hint -->
            <TextBlock Grid.Row="2" Text="Hold: A→Ą, C→Ć, E→Ę, L→Ł, N→Ń, O→Ó, S→Ś, Z→Ź/Ż PL for full Polish"
                       FontSize="9"
                       Foreground="#9CA3AF"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </Grid>
    </Border>
</Window>
