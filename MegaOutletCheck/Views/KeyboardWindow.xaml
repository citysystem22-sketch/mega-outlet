<Window x:Class="MegaOutletCheck.Views.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klawiatura"
        Width="600" Height="320"
        MinWidth="400" MinHeight="220"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#FFFFFF"
            CornerRadius="12"
            Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="4,4,4,8" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <TextBlock Text="⌨️ Klawiatura ekranowa"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           VerticalAlignment="Center"/>
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#6B7280"
                        FontSize="14"
                        Cursor="Hand"
                        Padding="8,4"/>
            </Grid>

            <!-- Keyboard Content (changes based on mode) -->
            <Grid Grid.Row="1">
                <!-- Standard QWERTY -->
                <ScrollViewer x:Name="StandardKeyboard"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <UniformGrid Rows="1" Margin="0,0,0,4">
                            <Button Content="Q" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="W" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="E" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="R" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="T" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="Y" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="U" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="I" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="O" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="P" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        </UniformGrid>
                        <UniformGrid Rows="1" Margin="0,0,0,4">
                            <Button Content="A" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="S" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="D" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="F" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="G" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="H" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="J" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="K" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="L" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                        </UniformGrid>
                        <UniformGrid Rows="1" Margin="0,0,0,4">
                            <Button Content="Z" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="X" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="C" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="V" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="B" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="N" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="M" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="⌫" Click="BackspaceButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="16"/>
                        </UniformGrid>
                        <UniformGrid Rows="1">
                            <Button x:Name="PLButton" Content="PL" Click="PolishMode_Click" Style="{DynamicResource BaseButton}" Width="80"/>
                            <Button Content="Space" Click="KeyButton_Click" Style="{DynamicResource KeyboardKeySpace}"/>
                            <Button Content="Szukaj 🔎" Click="SearchButton_Click" Style="{DynamicResource PrimaryButton}" Width="120"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Polish Characters (shown when PL pressed) -->
                <ScrollViewer x:Name="PolishKeyboard"
                            Visibility="Collapsed"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <UniformGrid Rows="1" Margin="0,0,0,4">
                            <Button Content="ą" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="ć" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="ę" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="ł" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="ń" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="ó" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="ś" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="ź" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="ż" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                        </UniformGrid>
                        <UniformGrid Rows="1" Margin="0,0,0,4">
                            <Button Content="Ą" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="Ć" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="Ę" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="Ł" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="Ń" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="Ó" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="Ś" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="Ź" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                            <Button Content="Ż" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="18"/>
                        </UniformGrid>
                        <UniformGrid Rows="1" Margin="0,0,0,4">
                            <Button Content="—" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="(" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content=")" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="." Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="," Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="?" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="!" Click="KeyButton_Click" Style="{DynamicResource KeyboardKey}"/>
                            <Button Content="⌫" Click="BackspaceButton_Click" Style="{DynamicResource KeyboardKey}" FontSize="16"/>
                        </UniformGrid>
                        <UniformGrid Rows="1">
                            <Button Content="PL ⭐" Click="PolishMode_Click" Style="{DynamicResource BaseButton}" Width="80" Background="#10B981" Foreground="White"/>
                            <Button Content="Space" Click="KeyButton_Click" Style="{DynamicResource KeyboardKeySpace}"/>
                            <Button Content="Szukaj 🔎" Click="SearchButton_Click" Style="{DynamicResource PrimaryButton}" Width="120"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
